BOT_TOKEN=your_bot_token_from_botfather
OWNER_ID=123456789

# Модуль 1 — Google Sheets (вытащить и поискать данные)
SHEET_ID=your_google_sheet_id_from_url
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# Модуль 2 — Почта IMAP (пересылать новые письма в Telegram)
EMAIL_HOST=imap.yandex.ru
EMAIL_USER=your@yandex.ru
EMAIL_PASS=your_app_password
EMAIL_FROM_FILTER=@turop.ru

# Модуль 3 — CRM / REST API (найти клиента или заявку)
CRM_API_URL=https://api.u-on.ru/KEY
CRM_API_KEY=your_api_key
